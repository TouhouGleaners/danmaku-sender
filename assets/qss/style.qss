/* 全局基础色 */
QMainWindow {
    background-color: {bg_base};
}

/* 侧边栏整体 */
QFrame#sidebarFrame {
    background-color: {bg_surface};
    border-right: 1px solid {border_color};
}

/* 用户状态区 */
QFrame#userWidget:hover {
    background-color: {bg_hover}; /* 动态悬停反馈 */
}

QLabel#avatarLabel {
    background-color: {border_color};
    border-radius: 18px; /* 圆形头像感 */
}

/* 侧边栏 */
QListWidget#sidebar {
    background-color: {bg_surface};
    border: none;
    border-right: 1px solid {border_color};
    outline: none;
    show-decoration-selected: 1;
}

/* 侧边栏item */
QListWidget#sidebar::item {
    height: 40px;
    padding-left: 15px;
    color: {text_main};
    border-bottom: 1px solid transparent;
}

/* 侧边栏item 悬停 */
QListWidget#sidebar::item:hover {
    background-color: {bg_hover};
}

/* 侧边栏item 选中 */
QListWidget#sidebar::item:selected {
    background-color: {bg_base};
    color: {primary};
    font-weight: 600;
    border-left: 4px solid {primary};
    margin-right: -1px;
}

/* --- 操作按钮基础样式 --- */
QPushButton[action="true"] {
    color: white;
    font-weight: bold;
    padding: 6px 15px;
    border-radius: 4px;
    border: none;
}

/* 状态：准备就绪 (ready) -> 绿色 */
QPushButton[action="true"][state="ready"] {
    background-color: {success};
}
QPushButton[action="true"][state="ready"]:hover {
    background-color: #27ae60;
}
QPushButton[action="true"][state="ready"]:disabled {
    background-color: {border_color};
}

/* 状态：运行中 (running) -> 红色 */
QPushButton[action="true"][state="running"] {
    background-color: {danger};
}
QPushButton[action="true"][state="running"]:hover {
    background-color: #c0392b;
}

/* 主操作按钮（如「新建任务」）：与维护操作区分层 */
*[primary="true"] {
    color: white;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 4px;
    border: none;
    background-color: {success};
}
*[primary="true"]:hover {
    background-color: #27ae60;
}
*[primary="true"]:disabled {
    background-color: {border_color};
}

/* ========================================= */
/* UIBinder 动态错误状态样式 (Invalid State)  */
/* ========================================= */

*[invalid="true"] {
    border: 1px solid {danger} !important;
    background-color: {danger_bg} !important;
}

*[invalid="true"]:focus {
    border: 1px solid {danger} !important;
}

/* 账号管理 - 账号行 */
QFrame#accountRow {
    border: none;
    border-bottom: 1px solid {border_color};
}
QFrame#accountRow:hover {
    background-color: {bg_hover};
}
QFrame#accountRow[active="true"] {
    background-color: {bg_hover};
}
QPushButton#accountIconBtn {
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    padding: 2px;
}
QPushButton#accountIconBtn:hover {
    background-color: {bg_hover};
    border-color: {border_color};
}
QPushButton#accountIconBtn:pressed {
    background-color: {border_color};
}

/* 账号管理 - 激活指示条 */
QFrame#accountAccent {
    background-color: transparent;
    border-radius: 1px;
}
QFrame#accountAccent[active="true"] {
    background-color: #2196F3;
}

/* 账号管理 - 标题 */
QLabel#accountDialogTitle {
    font-size: 15px;
    font-weight: bold;
    color: {text_main};
}
QLabel#accountDialogCount {
    font-size: 12px;
    color: {text_secondary};
}

/* 账号管理 - 昵称 */
QLabel#accountName {
    font-size: 15px;
    font-weight: bold;
    color: {text_main};
}

/* 账号管理 - 凭据行 */
QLabel#credValue {
    font-family: Consolas, monospace;
    font-size: 11px;
    color: {text_secondary};
}

/* 账号管理 - 状态文字 */
QLabel#accountStatus[status="valid"] {
    color: {success};
}
QLabel#accountStatus[status="invalid"] {
    color: {danger};
}
QLabel#accountStatus[status="unknown"] {
    color: {text_secondary};
}

/* 设置页 - 危险区：QFrame 画框，QGroupBox 不碰 */
QFrame#dangerFrame {
    border: 1px solid {danger};
    border-radius: 2px;
    background-color: {danger_bg};
}
QLabel#dangerTitle {
    color: {danger};
    font-weight: bold;
}
QLabel#dangerHint {
    color: {danger};
    font-size: 11px;
}

/* 拖放覆盖层：遮罩色随主题反向取，浅色压暗、深色提亮 */
#dropOverlay[theme="light"] {
    background-color: rgba(0, 0, 0, 0.18);
}
#dropOverlay[theme="dark"] {
    background-color: rgba(255, 255, 255, 0.20);
}
QLabel#dropOverlayTitle {
    font-size: 16px;
    font-weight: bold;
}
QLabel#dropOverlayHint {
    font-size: 12px;
}

/* 表格空状态引导：文字颜色跟随调色板，只定字号层级 */
QLabel#emptyStateHintTitle {
    font-size: 14px;
}
QLabel#emptyStateHintDesc {
    font-size: 12px;
}

/* 应用内通知卡片 */
QFrame#notificationCard {
    background-color: {bg_surface};
    border: 1px solid {border_color};
    border-radius: 6px;
}
QFrame#notificationCard:hover {
    background-color: {bg_hover};
    border-color: {text_secondary};
}
QFrame#notificationAccent {
    border: none;
    border-radius: 1px;
}
QFrame#notificationAccent[level="info"] {
    background-color: {primary};
}
QFrame#notificationAccent[level="warning"] {
    background-color: {warning};
}
QFrame#notificationAccent[level="error"] {
    background-color: {danger};
}
QLabel#notificationTitle {
    font-size: 12px;
    font-weight: bold;
    color: {text_main};
}
QLabel#notificationMessage {
    font-size: 12px;
    color: {text_secondary};
}
QWidget#notificationCountdown {
    border: none;
}
QWidget#notificationCountdown[level="info"] {
    color: {primary};
}
QWidget#notificationCountdown[level="warning"] {
    color: {warning};
}
QWidget#notificationCountdown[level="error"] {
    color: {danger};
}
