/* 全局基础色 */
QMainWindow {
    background-color: {SolidBackgroundFillColorBase};
}

/* 侧边栏整体 */
QFrame#sidebarFrame {
    background-color: {SolidBackgroundFillColorSecondary};
    border-right: 1px solid {ControlStrokeColorDefault};
}

/* 内容区 */
QStackedWidget#contentStack {
    background-color: {SolidBackgroundFillColorTertiary};
}

/* 滚动区域：不画自身底色，沿用所在容器的表面色 */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* 滚动条：轨道透明，滑块为内缩胶囊，尺寸恒定。
   圆角取短边一半，再大 Qt 会画出方角。 */
QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 12px;
}
QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 12px;
}
QScrollBar::handle:vertical {
    background-color: {ControlStrokeColorDefault};
    min-height: 24px;
    margin: 4px 3px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background-color: {ControlStrokeColorDefault};
    min-width: 24px;
    margin: 3px 4px;
    border-radius: 3px;
}
QScrollBar::handle:hover {
    background-color: {TextFillColorSecondary};
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* 数值框：边框与步进区由 ui/framework/number_box.py 绘制，QSS 只负责内边距。
   左右内边距为步进区让位，数字居中其内，加减号悬停时复现。 */
QSpinBox, QDoubleSpinBox {
    background: transparent;
    border: none;
    padding: 4px 12px;
    selection-background-color: {AccentFillColorDefault};
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 0;
    border: none;
    background: none;
}
QSpinBox::up-arrow, QSpinBox::down-arrow,
QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border: none;
}

/* 用户状态区 */
QFrame#userWidget:hover {
    background-color: {ControlFillColorSecondary}; /* 动态悬停反馈 */
}

QLabel#avatarLabel {
    background-color: {ControlStrokeColorDefault};
    border-radius: 18px; /* 圆形头像感 */
}

/* 侧边栏 */
QListWidget#sidebar {
    background-color: {SolidBackgroundFillColorSecondary};
    border: none;
    border-right: 1px solid {ControlStrokeColorDefault};
    outline: none;
    show-decoration-selected: 1;
}

/* 侧边栏item */
QListWidget#sidebar::item {
    height: 40px;
    padding-left: 15px;
    color: {TextFillColorPrimary};
    border-bottom: 1px solid transparent;
}

/* 侧边栏item 悬停 */
QListWidget#sidebar::item:hover {
    background-color: {ControlFillColorSecondary};
}

/* 侧边栏item 选中 */
QListWidget#sidebar::item:selected {
    background-color: {CardBackgroundFillColorDefault};
    color: {AccentFillColorDefault};
    font-weight: 600;
    border-left: 4px solid {AccentFillColorDefault};
    margin-right: -1px;
}

/* --- 操作按钮基础样式 --- */
QPushButton[action="true"] {
    color: white;
    font-weight: bold;
    padding: 6px 15px;
    border-radius: 4px;
    border: none;
}

/* 状态：准备就绪 (ready) -> 绿色 */
QPushButton[action="true"][state="ready"] {
    background-color: {SystemFillColorSuccess};
}
QPushButton[action="true"][state="ready"]:hover {
    background-color: #27ae60;
}
QPushButton[action="true"][state="ready"]:disabled {
    background-color: {ControlStrokeColorDefault};
}

/* 状态：运行中 (running) -> 红色 */
QPushButton[action="true"][state="running"] {
    background-color: {SystemFillColorAttention};
}
QPushButton[action="true"][state="running"]:hover {
    background-color: #c0392b;
}

/* 主操作按钮（如「新建任务」）：与维护操作区分层 */
*[primary="true"] {
    color: white;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 4px;
    border: none;
    background-color: {SystemFillColorSuccess};
}
*[primary="true"]:hover {
    background-color: #27ae60;
}
*[primary="true"]:disabled {
    background-color: {ControlStrokeColorDefault};
}

/* ========================================= */
/* UIBinder 动态错误状态样式 (Invalid State)  */
/* ========================================= */

*[invalid="true"] {
    border: 1px solid {SystemFillColorAttention} !important;
    background-color: {SystemFillColorAttentionBackground} !important;
}

*[invalid="true"]:focus {
    border: 1px solid {SystemFillColorAttention} !important;
}

/* 账号管理 - 账号行 */
QFrame#accountRow {
    border: none;
    border-bottom: 1px solid {ControlStrokeColorDefault};
}
QFrame#accountRow:hover {
    background-color: {ControlFillColorSecondary};
}
QFrame#accountRow[active="true"] {
    background-color: {ControlFillColorSecondary};
}
QPushButton#accountIconBtn {
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    padding: 2px;
}
QPushButton#accountIconBtn:hover {
    background-color: {ControlFillColorSecondary};
    border-color: {ControlStrokeColorDefault};
}
QPushButton#accountIconBtn:pressed {
    background-color: {ControlStrokeColorDefault};
}

/* 账号管理 - 激活指示条 */
QFrame#accountAccent {
    background-color: transparent;
    border-radius: 1px;
}
QFrame#accountAccent[active="true"] {
    background-color: #2196F3;
}

/* 账号管理 - 标题 */
QLabel#accountDialogTitle {
    font-size: 15px;
    font-weight: bold;
    color: {TextFillColorPrimary};
}
QLabel#accountDialogCount {
    font-size: 12px;
    color: {TextFillColorSecondary};
}

/* 账号管理 - 昵称 */
QLabel#accountName {
    font-size: 15px;
    font-weight: bold;
    color: {TextFillColorPrimary};
}

/* 账号管理 - 凭据行 */
QLabel#credValue {
    font-family: Consolas, monospace;
    font-size: 11px;
    color: {TextFillColorSecondary};
}

/* 账号管理 - 状态文字 */
QLabel#accountStatus[status="valid"] {
    color: {SystemFillColorSuccess};
}
QLabel#accountStatus[status="invalid"] {
    color: {SystemFillColorAttention};
}
QLabel#accountStatus[status="unknown"] {
    color: {TextFillColorSecondary};
}

/* 卡片容器：圆角填充加细边框，用于分组呈现内容。
   appearance 取自表面层级：layer 为表面、alt 为表面内的次级填充、
   canvas 为最底层、overlay 为半透明覆盖。 */
QFrame#card {
    background-color: {CardBackgroundFillColorDefault};
    border: 1px solid {CardStrokeColorDefault};
    border-bottom-color: {ControlStrokeColorDefault};
    border-radius: 4px;
}
QFrame#card[appearance="alt"] {
    background-color: {CardBackgroundFillColorSecondary};
}
QFrame#card[appearance="canvas"] {
    background-color: {SolidBackgroundFillColorBase};
    border: none;
}
QFrame#card[appearance="overlay"] {
    background-color: {LayerFillColorDefault};
    border: none;
}
/* canvas / overlay 默认无边框，显式要求绘制时仍按属性兑现 */
QFrame#card[appearance="canvas"][border="true"],
QFrame#card[appearance="overlay"][border="true"] {
    border: 1px solid {CardStrokeColorDefault};
}
QFrame#card[border="false"] {
    border: none;
}

/* 设置项行：名称与说明以字号和色阶分层 */
QLabel#settingsRowTitle {
    font-size: 14px;
}
QLabel#settingsRowSubtitle {
    font-size: 12px;
    color: {TextFillColorSecondary};
}

/* 设置页节标题：与设置行名称同号，层级由「在卡片外」体现 */
QLabel#settingsSectionTitle {
    font-size: 14px;
    font-weight: 600;
    min-height: 24px;
}

/* 高风险设置行：红框红底，文字配色与普通设置行一致 */
QFrame#card[danger="true"] {
    border-color: {SystemFillColorAttention};
    background-color: {SystemFillColorAttentionBackground};
}

/* 拖放覆盖层：遮罩色随主题反向取，浅色压暗、深色提亮 */
#dropOverlay[theme="light"] {
    background-color: rgba(0, 0, 0, 0.18);
}
#dropOverlay[theme="dark"] {
    background-color: rgba(255, 255, 255, 0.20);
}
QLabel#dropOverlayTitle {
    font-size: 16px;
    font-weight: bold;
}
QLabel#dropOverlayHint {
    font-size: 12px;
}

/* 表格空状态引导：文字颜色跟随调色板，只定字号层级 */
QLabel#emptyStateHintTitle {
    font-size: 14px;
}
QLabel#emptyStateHintDesc {
    font-size: 12px;
}

/* 应用内通知卡片 */
QFrame#notificationCard {
    background-color: {CardBackgroundFillColorDefault};
    border: 1px solid {ControlStrokeColorDefault};
    border-radius: 6px;
}
QFrame#notificationCard:hover {
    background-color: {ControlFillColorSecondary};
    border-color: {TextFillColorSecondary};
}
QLabel#notificationTitle {
    font-size: 13px;
    font-weight: bold;
    color: {TextFillColorPrimary};
}
QLabel#notificationMessage {
    font-size: 12px;
    color: {TextFillColorSecondary};
}
QWidget#notificationCountdown {
    border: none;
}
